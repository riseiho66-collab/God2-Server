{
  "server": {"name": "GOD2 Startup Test", "host": "127.0.0.1", "port": 0, "max_sessions": 8, "worker_threads": 2},
  "protocol": {"name": "GOD2", "mode": "placeholder", "packet_header": "uint16_length_uint16_opcode", "encryption": "none", "compression": "none", "packet_dump": false},
  "database": {"type": "sqlite", "path": "@CMAKE_CURRENT_BINARY_DIR@/smoke.db"},
  "lua": {"bootstrap": "@PROJECT_SOURCE_DIR@/scripts/bootstrap.lua", "script_root": "@PROJECT_SOURCE_DIR@/scripts", "hot_reload": false},
  "logging": {"level": "info", "file": "@CMAKE_CURRENT_BINARY_DIR@/smoke.log"},
  "development": {"mock_login": true}
}
