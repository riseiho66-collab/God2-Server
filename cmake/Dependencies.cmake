include(FetchContent)
set(FETCHCONTENT_QUIET OFF)
set(SPDLOG_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(JSON_BuildTests OFF CACHE BOOL "" FORCE)
set(SOL2_BUILD_LUA OFF CACHE BOOL "" FORCE)
FetchContent_Declare(spdlog URL https://github.com/gabime/spdlog/archive/refs/tags/v1.14.1.tar.gz URL_HASH SHA256=1586508029a7d0670dfcb2d97575dcdc242d3868a259742b69f100801ab4e16b DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
FetchContent_Declare(json URL https://github.com/nlohmann/json/archive/refs/tags/v3.11.3.tar.gz URL_HASH SHA256=0d8ef5af7f9794e3263480193c491549b2ba6cc74bb018906202ada498a79406 DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
FetchContent_Declare(sol2 URL https://github.com/ThePhD/sol2/archive/refs/tags/v3.3.1.tar.gz URL_HASH SHA256=ad121461047d52b449aa84234a6b578fa3ed95d67d1a0703902eba72417f61bb DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
FetchContent_Declare(asio_src URL https://github.com/chriskohlhoff/asio/archive/refs/tags/asio-1-30-2.tar.gz URL_HASH SHA256=755bd7f85a4b269c67ae0ea254907c078d408cce8e1a352ad2ed664d233780e8 DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
FetchContent_Declare(lua_src URL https://www.lua.org/ftp/lua-5.4.8.tar.gz URL_HASH SHA256=4f18ddae154e793e46eeab727c59ef1c0c0c2b744e7b94219710d76f530629ae DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
FetchContent_Declare(sqlite_src URL https://www.sqlite.org/2025/sqlite-amalgamation-3500400.zip URL_HASH SHA256=1d3049dd0f830a025a53105fc79fd2ab9431aea99e137809d064d8ee8356b032 DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
FetchContent_MakeAvailable(spdlog json sol2 asio_src lua_src sqlite_src)
if(MSVC)
  target_compile_options(spdlog PRIVATE /utf-8)
endif()
find_package(Threads REQUIRED)
add_library(asio INTERFACE)
target_include_directories(asio SYSTEM INTERFACE ${asio_src_SOURCE_DIR}/asio/include)
target_compile_definitions(asio INTERFACE ASIO_STANDALONE)
target_link_libraries(asio INTERFACE Threads::Threads)
if(WIN32)
  target_link_libraries(asio INTERFACE ws2_32 mswsock)
endif()
file(GLOB LUA_SOURCES CONFIGURE_DEPENDS ${lua_src_SOURCE_DIR}/src/*.c)
list(FILTER LUA_SOURCES EXCLUDE REGEX "/(lua|luac)\\.c$")
add_library(lua STATIC ${LUA_SOURCES})
target_include_directories(lua SYSTEM PUBLIC ${lua_src_SOURCE_DIR}/src)
if(UNIX)
  target_compile_definitions(lua PRIVATE LUA_USE_POSIX)
  target_link_libraries(lua PUBLIC m ${CMAKE_DL_LIBS})
endif()
add_library(sqlite3 STATIC ${sqlite_src_SOURCE_DIR}/sqlite3.c)
target_include_directories(sqlite3 SYSTEM PUBLIC ${sqlite_src_SOURCE_DIR})
target_compile_definitions(sqlite3 PRIVATE SQLITE_THREADSAFE=1 SQLITE_OMIT_LOAD_EXTENSION)
target_link_libraries(sqlite3 PUBLIC Threads::Threads ${CMAKE_DL_LIBS})
